# One Claude Remote Control server per repo, started by `rrcd start`. The
# instance is the repo path escaped with `systemd-escape --path`, so %I is the
# path without its leading slash.
#
# The infra-box session tested this template's core; the rest is from the
# Docker checks in test/docker/ (see DESIGN.md):
# - rrcd serve reads the repo's flags from the file rrcd start writes, empties
#   the output file and runs claude with its output there; rrcd reads the
#   environment URL from it, because the URL changes on every restart. Not
#   EnvironmentFile= and StandardOutput=truncate:, as in 2.0.0: systemd 245
#   (Ubuntu 20.04) has no truncate:, and could not find a %i.env for a path
#   with a hyphen in it, whose instance name holds \x2d (2 Nov). %I, the
#   unescaped path, is all the unit passes on
# - a server started just after another one in the same folder stopped is
#   refused for about 70 seconds and exits; Restart=always retries it
# - after about 10 minutes without a network the server exits with status 0
#   (infra-box offline check, 26 Oct: "disconnected 9m 54s",
#   Result=success), which Restart=on-failure left down for good.
#   Restart=always brings it back; rrcd stop (systemctl stop) still stops it
# - a server killed by a reboot leaves its sessions' worktrees locked to its
#   dead PID; rrcd tidy releases those and removes the ones with no work
#   before each start. The "-": a failed tidy never stops the server
# - no Environment=PATH=: rrcd serve takes the PATH from the user's login
#   shell, ~/.local/bin first. The manager's PATH has no ~/.local/bin, so
#   every rrcd call a server's session made failed with "rrcd: command not
#   found" (infra-box, 3 Nov); 2.0.2's fixed PATH= line cured that but, as
#   systemd can't expand $PATH there, dropped /usr/sbin, /sbin, /snap/bin and
#   everything ~/.profile and ~/.bashrc add (9 Nov). environment.d did not
#   reach the unit after daemon-reload

[Unit]
Description=Claude Remote Control server in /%I

[Service]
WorkingDirectory=/%I
ExecStartPre=-%h/.local/bin/rrcd tidy "/%I"
ExecStart=%h/.local/bin/rrcd serve "/%I"
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
