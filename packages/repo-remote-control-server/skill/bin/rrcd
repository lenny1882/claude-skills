#!/usr/bin/env bash
# rrcd: one Claude Remote Control server per repo, as a systemd user service.
#
# Why this exists: `claude remote-control` only opens sessions in its own
# directory, so reaching every repo on an always-on box from claude.ai needs
# one server per repo, and each has to survive reboots. Starting one by hand
# means trusting the repo in ~/.claude.json, writing a unit, and fishing the
# environment URL out of a redrawing status screen. rrcd does it the same way
# every time, for you over SSH and for the orchestrator through the skill.
# DESIGN.md has each decision and the Docker evidence behind it.
#
# It builds on repo-remote-control-session: finding the repo, trust, the lock
# and reading the output are rrc's, sourced from the rrc on PATH, so they
# exist once. This file holds what only a server needs.
#
# Things that look simplifiable and are not:
# - The URL is read from the server's output on every call, never stored: it
#   changes on every restart.
# - Hand out the URL, not the environment name. The app names an environment
#   after the folder, and a stopped server's environment can stay listed
#   under the same name; a session opened in it never starts.
# - A server started just after another one in the same folder stopped is
#   refused for about 70 seconds ("already served") and exits. The unit's
#   Restart=always retries it (it also brings back a server that exited with
#   status 0 after ~10 minutes offline); rrcd start only waits for the URL.
# - Servers run from boot only with linger on: without it systemd stops every
#   user unit when the last login ends. The first rrcd start turns it on.
# - rrcd must run outside Claude's sandbox: the sandbox blocks the user bus,
#   ~/.config/systemd/user and ~/.claude.json. The installer adds one
#   sandbox.excludedCommands entry per subcommand Claude may run (start,
#   clone, list, restart, stop). remove, restart-all and teardown are left
#   out, so they fail from Claude and the user runs them.

set -euo pipefail

RRC_LIB=${RRCD_RRC:-$(command -v rrc 2>/dev/null || true)}
if [ -z "$RRC_LIB" ] || [ ! -f "$RRC_LIB" ]; then
	printf 'rrcd: needs rrc from repo-remote-control-session, and no rrc is on PATH: install that package first\n' >&2
	exit 1
fi
# shellcheck source=/dev/null
. "$RRC_LIB"

PROG=rrcd
SKILL=${RRCD_SKILL_DIR:-$CLAUDE_DIR/skills/repo-remote-control-server}
STATE=${RRCD_STATE:-$SKILL/state}

usage() {
	cat <<-'EOF'
		usage: rrcd <command> [options] [dir]

		  start [dir]     trust the repo, enable and start its server, print its URL
		      --permission-mode <mode>   for its sessions (default auto)
		      --create-session-in-dir    also open a session in the main checkout at start
		      --no-create-session-in-dir (the default)
		      --prefix <prefix>          session-title prefix (default: path under ~/repos)
		      --allow-unsandboxed        start even though sandbox.enabled is off;
		                                 only with the user's explicit yes
		  clone <url-or-slug> [path]   clone into ~/repos/[path]/<name>, then start it
		      --name <folder>            clone into this folder name instead
		      (and any start option)     a slug needs CLONE_BASE in state/config
		  list            every repo with a server
		  url [dir]       the server's current URL
		  restart [dir]   restart the server (ends its open sessions), print its URL
		  restart-all     restart every running server (ends their open sessions)
		  stop [dir]      stop the server; it comes back at the next boot
		  disable [dir]   stop it and keep it off; trust and settings stay
		  remove [dir]    disable, forget its settings and output, clear its trust,
		                  and list the server's worktrees
		      --worktrees   also delete the server's worktrees that have no
		                    uncommitted or unpushed work
		      --force       with --worktrees, delete those with work as well

		  teardown        stop and disable every server and the update watcher,
		                  and unlink the units: run before uninstalling

		rrcd on-update is run by rrc-update.service when claude is updated.
		rrcd tidy [dir] is run before every server start: it releases worktree
		locks left by a server that didn't exit cleanly and removes those
		worktrees when they hold no work (state/logs/tidy.log says what it did).

		dir defaults to the current directory; any directory inside the repo will do.
		Give people the URL rrcd prints, never the environment's name.
		One-off sessions are repo-remote-control-session's: rrc session.
	EOF
}

# --------------------------------
# repos, units and files

unitOf() { serverUnitOf "$1"; }
envFileOf() { printf '%s/repos/%s.env' "$STATE" "$1"; }
logFileOf() { printf '%s/logs/%s.log' "$STATE" "$1"; }

reposRoot() { local r; r=$(valueIn "$STATE/config" REPOS_ROOT); printf '%s' "${r:-$HOME/repos}"; }

# the repo's path under ~/repos, made safe for an argument: client_hugoboss/web
defaultPrefix() {
	local root=$1 base rel
	base=$(reposRoot)
	case $root in "$base"/*) rel=${root#"$base"/} ;; *) rel=$(basename "$root") ;; esac
	sanitisePrefix "$rel"
}
sanitisePrefix() { printf '%s' "$1" | sed 's#[^A-Za-z0-9._/-]#-#g'; }

# Linked rather than copied, as rrc's session unit is, so an upgrade of the
# skill is picked up by the next daemon-reload.
ensureUnits() {
	local t src dst
	for t in rrc-server@.service rrc-update.path rrc-update.service; do
		src=$SKILL/systemd/$t dst=$UNIT_DIR/$t
		[ -f "$src" ] || die "the repo-remote-control-server skill is not installed: no $src"
		if [ "$(readlink "$dst" 2>/dev/null)" != "$src" ]; then
			mkdir -p "$UNIT_DIR"
			ln -sfn "$src" "$dst"
		fi
	done
	systemctl --user daemon-reload
	systemctl --user is-enabled --quiet rrc-update.path 2>/dev/null \
		|| systemctl --user enable --now --quiet rrc-update.path
	ensureLinger
}

# Without linger the user's systemd instance stops when the last login ends,
# and every server with it; with it, servers start at boot with nobody logged
# in. Done here rather than by the installer, which has no step for it.
ensureLinger() {
	local user
	user=$(id -un)
	[ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null)" = yes ] && return 0
	if loginctl enable-linger "$user" 2>/dev/null; then
		note "turned on linger for $user: servers now start at boot and keep running after you log out"
	else
		note "warning: linger is off and could not be turned on, so servers stop when you log out."
		note "  Run in your own terminal: loginctl enable-linger $user"
	fi
}

# the claude binary a running unit was started from
runningExe() {
	local pid exe
	pid=$(systemctl --user show -p MainPID --value "$1" 2>/dev/null || true)
	[ -n "$pid" ] && [ "$pid" != 0 ] || return 0
	exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
	printf '%s' "${exe% (deleted)}"
}
currentClaude() { readlink -f "$HOME/.local/bin/claude" 2>/dev/null || true; }

# --------------------------------
# commands

cmdStart() {
	local dir=. mode="" create="" prefix="" allow=""
	while [ $# -gt 0 ]; do
		case $1 in
			--permission-mode) mode=${2:-}; shift ;;
			--permission-mode=*) mode=${1#*=} ;;
			--create-session-in-dir) create=yes ;;
			--no-create-session-in-dir) create=no ;;
			--prefix) prefix=${2:-}; shift ;;
			--prefix=*) prefix=${1#*=} ;;
			--allow-unsandboxed) allow=yes ;;
			-*) die "start: unknown option $1" ;;
			*) dir=$1 ;;
		esac
		shift
	done

	local root inst unit env log
	root=$(repoRoot "$dir")
	inst=$(instanceOf "$root"); unit=$(unitOf "$inst")
	env=$(envFileOf "$inst"); log=$(logFileOf "$inst")
	lock

	# options not given keep what this repo had, else the defaults
	mode=${mode:-$(valueIn "$env" RRC_PERMISSION_MODE)}; mode=${mode:-auto}
	create=${create:-$(valueIn "$env" RRC_CREATE_SESSION_IN_DIR)}; create=${create:-no}
	prefix=${prefix:-$(valueIn "$env" RRC_PREFIX)}; prefix=$(sanitisePrefix "${prefix:-$(defaultPrefix "$root")}")
	allow=${allow:-$(valueIn "$env" RRC_ALLOW_UNSANDBOXED)}; allow=${allow:-no}
	case " $MODES " in *" $mode "*) ;; *) die "start: --permission-mode must be one of: $MODES" ;; esac
	[ -n "$prefix" ] || die "start: the prefix is empty"

	[ "$allow" = yes ] || needSandbox "that choice is remembered for this repo."

	local args="--permission-mode $mode"
	[ "$create" = yes ] && args+=" --create-session-in-dir" || args+=" --no-create-session-in-dir"
	args+=" --remote-control-session-name-prefix $prefix"

	mkdir -p "$STATE/repos" "$STATE/logs"
	local new changed=no
	new=$(cat <<-EOF
		# written by rrcd start; change it with rrcd start and its options
		RRC_ROOT="$root"
		RRC_PERMISSION_MODE="$mode"
		RRC_CREATE_SESSION_IN_DIR="$create"
		RRC_PREFIX="$prefix"
		RRC_ALLOW_UNSANDBOXED="$allow"
		RRC_ARGS="$args"
	EOF
	)
	if [ "$new" != "$(cat "$env" 2>/dev/null)" ]; then
		[ -f "$env" ] && changed=yes
		printf '%s\n' "$new" >"$env.tmp" && mv "$env.tmp" "$env"
	fi

	setTrust "$root"
	ensureUnits

	if systemctl --user is-active --quiet "$unit"; then
		systemctl --user enable --quiet "$unit"
		if [ "$changed" = yes ]; then
			note "restarting $root with its new settings; this ends its open sessions"
			startFresh "$unit" "$log"
		fi
	else
		systemctl --user enable --quiet "$unit"
		startFresh "$unit" "$log"
	fi

	local url
	url=$(waitForUrl "$unit" "$log" "$root")
	printf '%s\n%s\n' "$root" "$url"
}

cmdClone() {
	local src="" path="" name="" allow=no startArgs=()
	while [ $# -gt 0 ]; do
		case $1 in
			--name) name=${2:-}; shift ;;
			--name=*) name=${1#*=} ;;
			--permission-mode|--prefix) startArgs+=("$1" "${2:-}"); shift ;;
			--allow-unsandboxed) allow=yes; startArgs+=("$1") ;;
			-*) startArgs+=("$1") ;;
			*) if [ -z "$src" ]; then src=$1; elif [ -z "$path" ]; then path=$1; else die "clone: too many arguments"; fi ;;
		esac
		shift
	done
	[ -n "$src" ] || die "clone: give a URL or a repo slug"

	# No built-in host: each machine names its own, so a slug can't be cloned
	# from somewhere this machine never meant
	local url base repos parent folder dest
	case $src in
		*://*|*@*:*|/*|./*|../*) url=$src ;;
		*)
			base=$(valueIn "$STATE/config" CLONE_BASE)
			[ -n "$base" ] || die "clone: $src is a slug, and no CLONE_BASE is set. Give the full URL, or add a line such as CLONE_BASE=\"git@ssh.bitbucket.org:<workspace>/\" to $STATE/config"
			url=$base$src
			case $url in *.git) ;; *) url=$url.git ;; esac ;;
	esac
	folder=${name:-$(basename "${url%.git}")}
	repos=$(reposRoot)
	case $path in "") parent=$repos ;; /*) parent=$path ;; *) parent=$repos/$path ;; esac
	dest=$parent/$folder
	[ -e "$dest" ] && die "$dest already exists. rrcd start $dest serves it as it is."
	# checked before cloning, so a refusal leaves nothing half done
	[ "$allow" = yes ] || needSandbox "that choice is remembered for this repo."

	# the app names an environment after the folder: two repos called web show
	# as two environments called web
	local other
	other=$(find "$repos" -mindepth 1 -maxdepth 4 -type d -name "$folder" -exec test -e '{}/.git' ';' -print 2>/dev/null | head -1)
	[ -n "$other" ] && note "note: $other has the same folder name, so the app will list both as environment \"$folder\". rrcd clone --name <folder> avoids that. Hand out the URL, not the name."

	mkdir -p "$parent"
	git clone -q "$url" "$dest" || die "could not clone $url"
	cmdStart "$dest" ${startArgs[@]+"${startArgs[@]}"}
}

cmdList() {
	local files current env inst unit log root state enabled sessions url exe err
	shopt -s nullglob
	files=("$STATE"/repos/*.env)
	if [ "${#files[@]}" -eq 0 ]; then
		echo "no repo has a server; start one with: rrcd start <dir>"
		return 0
	fi
	current=$(currentClaude)
	for env in "${files[@]}"; do
		inst=$(basename "$env" .env); unit=$(unitOf "$inst"); log=$(logFileOf "$inst")
		root=$(valueIn "$env" RRC_ROOT)
		state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
		enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null || true)
		sessions=$(sessionsIn "$log"); url=$(urlIn "$log"); err=$(lastErrorIn "$log")
		printf '%s\n' "$root"
		printf '  %s, %s%s\n' "${state:-unknown}" "${enabled:-unknown}" "${sessions:+, sessions $sessions}"
		[ "$state" = active ] && [ -n "$url" ] && printf '  %s\n' "$url"
		if [ "$state" = active ] && [ -n "$current" ]; then
			exe=$(runningExe "$unit")
			if [ -n "$exe" ] && [ "$exe" != "$current" ]; then
				printf '  runs an older claude (%s; %s is installed): restarting it updates it and ends its open sessions\n' \
					"$(basename "$exe")" "$(basename "$current")"
			fi
		fi
		[ -n "$err" ] && printf '  last error: %s\n' "$err"
	done
	return 0
}

# the unit and env file for a dir's repo, or stop if rrcd never started one
known() { # dir
	local root inst
	root=$(repoRoot "$1"); inst=$(instanceOf "$root")
	[ -f "$(envFileOf "$inst")" ] || die "no server for $root: start one with rrcd start $root"
	printf '%s\n%s\n' "$root" "$inst"
}

# For rrc session, which is refused beside a server and hands this URL out
cmdUrl() {
	local dir=${1:-.} r inst url
	r=$(known "$dir"); inst=${r#*$'\n'}
	systemctl --user is-active --quiet "$(unitOf "$inst")" || die "the server for ${r%%$'\n'*} is not running"
	url=$(urlIn "$(logFileOf "$inst")")
	[ -n "$url" ] || die "no URL in the server's output yet"
	printf '%s\n' "$url"
}

restartOne() { # root inst: restart, wait, print root and URL
	local unit log url
	unit=$(unitOf "$2"); log=$(logFileOf "$2")
	startFresh "$unit" "$log"
	url=$(waitForUrl "$unit" "$log" "$1")
	printf '%s\n%s\n' "$1" "$url"
}

cmdRestart() {
	local dir=${1:-.} r root inst
	r=$(known "$dir"); root=${r%%$'\n'*}; inst=${r#*$'\n'}
	lock
	note "restarting $root; this ends its open sessions"
	restartOne "$root" "$inst"
}

cmdRestartAll() {
	local env inst any=no
	shopt -s nullglob
	lock
	for env in "$STATE"/repos/*.env; do
		inst=$(basename "$env" .env)
		systemctl --user is-active --quiet "$(unitOf "$inst")" || continue
		any=yes
		note "restarting $(valueIn "$env" RRC_ROOT)"
		restartOne "$(valueIn "$env" RRC_ROOT)" "$inst" || true
	done
	[ "$any" = yes ] || echo "no server is running"
}

# Run by rrc-update.service. Idle servers on an old binary restart now; ones
# with sessions open keep running it until the user says, because restarting
# ends those sessions. The orchestrator is told in its tmux pane, where the
# message waits its turn if it is busy (tmux-queue check, 22 Oct).
cmdOnUpdate() {
	local current env inst unit log root exe cap n busy=() restarted=() pane msg
	current=$(currentClaude)
	[ -n "$current" ] || return 0
	shopt -s nullglob
	lock
	mkdir -p "$STATE/logs"
	for env in "$STATE"/repos/*.env; do
		inst=$(basename "$env" .env); unit=$(unitOf "$inst"); log=$(logFileOf "$inst")
		root=$(valueIn "$env" RRC_ROOT)
		systemctl --user is-active --quiet "$unit" || continue
		exe=$(runningExe "$unit")
		[ -n "$exe" ] && [ "$exe" != "$current" ] || continue
		cap=$(sessionsIn "$log"); n=${cap%%/*}
		if [ "$n" = 0 ]; then
			startFresh "$unit" "$log"
			restarted+=("$root")
		else
			# no count in the output counts as busy: never end sessions on a guess
			busy+=("$root (${n:-unknown} open)")
		fi
	done
	[ "${#restarted[@]}" -gt 0 ] || [ "${#busy[@]}" -gt 0 ] || return 0

	{
		printf '%s claude is now %s\n' "$(date '+%F %T')" "$(basename "$current")"
		for root in ${restarted[@]+"${restarted[@]}"}; do printf '  restarted (idle): %s\n' "$root"; done
		for root in ${busy[@]+"${busy[@]}"}; do printf '  still on the old version: %s\n' "$root"; done
	} >>"$STATE/logs/update.log"
	[ "${#busy[@]}" -gt 0 ] || return 0

	pane=$(valueIn "$STATE/config" ORCHESTRATOR_TMUX); pane=${pane:-orchestrator:0}
	msg="[rrcd] claude was updated to $(basename "$current")."
	[ "${#restarted[@]}" -gt 0 ] && msg+=" Idle servers restarted: $(joined "${restarted[@]}")."
	msg+=" These servers have open sessions and still run the old version: $(joined "${busy[@]}"). Restarting one ends its sessions. Ask the user now which to restart, then run rrcd restart <dir> for each; rrcd restart-all, for every server, is the user's to run."
	if tmux has-session -t "${pane%%:*}" 2>/dev/null \
		&& tmux send-keys -t "$pane" -l "$msg" && tmux send-keys -t "$pane" Enter; then
		printf '  told the orchestrator at %s\n' "$pane" >>"$STATE/logs/update.log"
	else
		printf '  could not reach the orchestrator at %s; run rrcd list\n' "$pane" >>"$STATE/logs/update.log"
	fi
}
joined() { local out="" x; for x in "$@"; do out+="${out:+; }$x"; done; printf '%s' "$out"; }

# Undo what rrcd set up in systemd. The kit's uninstall.sh cannot do this
# itself, so manifest.sh's pre_uninstall runs it first; state/ stays until
# uninstall removes it. Sessions are rrc's, and rrc teardown's.
cmdTeardown() {
	local u
	shopt -s nullglob
	for u in "$STATE"/repos/*.env; do
		systemctl --user disable --now --quiet "$(unitOf "$(basename "$u" .env)")" 2>/dev/null || true
	done
	systemctl --user disable --now --quiet rrc-update.path 2>/dev/null || true
	systemctl --user stop rrc-update.service 2>/dev/null || true
	# a failed unit stays listed after its file is gone, until this
	systemctl --user reset-failed 'rrc-server@*' 'rrc-update.*' 2>/dev/null || true
	for u in rrc-server@.service rrc-update.path rrc-update.service; do
		rm -f "$UNIT_DIR/$u"
	done
	systemctl --user daemon-reload 2>/dev/null || true
	echo "stopped and disabled every server and the update watcher, and unlinked the units"
}

cmdStop() {
	local dir=${1:-.} r root inst
	r=$(known "$dir"); root=${r%%$'\n'*}; inst=${r#*$'\n'}
	systemctl --user stop "$(unitOf "$inst")"
	echo "stopped $root. It comes back at the next boot; rrcd disable keeps it off."
}

cmdDisable() {
	local dir=${1:-.} r root inst
	r=$(known "$dir"); root=${r%%$'\n'*}; inst=${r#*$'\n'}
	systemctl --user disable --now --quiet "$(unitOf "$inst")"
	echo "disabled $root. Its trust and settings stay, so rrcd start brings it back as it was."
}

cmdRemove() {
	local dir=. worktrees=no force=no
	while [ $# -gt 0 ]; do
		case $1 in
			--worktrees) worktrees=yes ;;
			--force) force=yes ;;
			-*) die "remove: unknown option $1" ;;
			*) dir=$1 ;;
		esac
		shift
	done
	[ "$force" = yes ] && [ "$worktrees" = no ] && die "remove: --force only means something with --worktrees"

	local root inst unit
	root=$(repoRoot "$dir"); inst=$(instanceOf "$root"); unit=$(unitOf "$inst")
	lock
	systemctl --user disable --now --quiet "$unit" 2>/dev/null || true
	rm -f "$(envFileOf "$inst")" "$(logFileOf "$inst")"
	clearTrust "$root"
	echo "removed the server for $root and cleared its trust"

	local wt branch dirty unpushed found=no
	while IFS=$'\t' read -r wt branch; do
		found=yes
		dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
		unpushed=$(git -C "$wt" rev-list HEAD --not --remotes 2>/dev/null | wc -l | tr -d ' ')
		printf '  %s  %s, %s uncommitted, %s unpushed' "$wt" "$branch" "$dirty" "$unpushed"
		if [ "$worktrees" = no ]; then
			printf '\n'
		elif [ "$dirty" = 0 ] && [ "$unpushed" = 0 ] || [ "$force" = yes ]; then
			git -C "$root" worktree remove --force "$wt"
			case $branch in worktree-bridge-*) git -C "$root" branch -D -q "$branch" 2>/dev/null || true ;; esac
			printf '  removed\n'
		else
			printf '  kept: it has work (--force deletes it anyway)\n'
		fi
	done < <(serverWorktrees "$root")
	if [ "$found" = no ]; then
		echo "  no server worktrees"
	elif [ "$worktrees" = no ]; then
		echo "  left in place; rrcd remove --worktrees deletes those with no uncommitted or unpushed work"
	fi
}

# The server's worktrees, one "path<TAB>branch" line each (branch "detached"
# when HEAD is): Claude puts them in .claude/worktrees/bridge-*
serverWorktrees() {
	local root=$1 line wt="" branch=detached
	while IFS= read -r line; do
		case $line in
			"worktree "*) wt=${line#worktree }; branch=detached ;;
			"branch refs/heads/"*) branch=${line#branch refs/heads/} ;;
		esac
		[ -n "$line" ] && continue
		case $wt in "$root"/.claude/worktrees/bridge-*) printf '%s\t%s\n' "$wt" "$branch" ;; esac
		wt=""
	done < <(git -C "$root" worktree list --porcelain; echo)
}

# Run by rrc-server@'s ExecStartPre, before the server starts in the repo.
# A server that exits cleanly releases its sessions' worktree locks and
# removes the worktrees with no changes. One killed by a reboot can't: its
# sessions' worktrees stay locked, each lock naming the dead server
# ("claude agent bridge-… (pid N start T)"), and git worktree prune skips them
# (aws-workspace offline and reboot checks, 26 Oct). tidy does what the clean
# exit would have: it releases a lock whose process is gone, removes a
# worktree with no uncommitted changes and no commits that no other branch or
# remote has, deletes its generated branch, and keeps the rest.
# No lock: rrcd start holds it while it waits for this very server.
cmdTidy() {
	local root wt branch lockf reason pid start dirty own log
	root=$(repoRoot "${1:-.}")
	mkdir -p "$STATE/logs"; log=$STATE/logs/tidy.log
	while IFS=$'\t' read -r wt branch; do
		lockf=$(sed -n 's/^gitdir: //p' "$wt/.git" 2>/dev/null)/locked
		if [ -f "$lockf" ]; then
			reason=$(cat "$lockf")
			case $reason in
				"claude agent "*"(pid "*" start "*")") ;;
				*) tidied "$wt: kept, locked by something other than a server: $reason"; continue ;;
			esac
			pid=${reason##*(pid }; pid=${pid%% *}
			start=${reason##* start }; start=${start%)}
			if running "$pid" "$start"; then
				tidied "$wt: kept, its session is running (pid $pid)"
				continue
			fi
			git -C "$root" worktree unlock "$wt"
		fi
		dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
		own=$(git -C "$wt" rev-list HEAD --not --exclude="$branch" --branches --remotes 2>/dev/null | wc -l | tr -d ' ')
		if [ "$dirty" = 0 ] && [ "$own" = 0 ]; then
			if ! git -C "$root" worktree remove "$wt" 2>>"$log"; then
				tidied "$wt: kept, git worktree remove failed (above)"
				continue
			fi
			case $branch in worktree-bridge-*) git -C "$root" branch -D -q "$branch" 2>/dev/null || true ;; esac
			tidied "$wt: removed"
		else
			tidied "$wt: kept, $dirty uncommitted, $own commits on no other branch"
		fi
	done < <(serverWorktrees "$root")
}
tidied() { printf '%s %s\n' "$(date '+%F %T')" "$1" | tee -a "$log"; }

# whether process $1 is running and started at $2, in clock ticks since boot
# (field 22 of /proc/PID/stat, the "start" in a Claude worktree lock); a PID
# reused after a reboot has a different start
running() {
	[ -r "/proc/$1/stat" ] || return 1
	[ "$(sed 's/.*) //' "/proc/$1/stat" | cut -d' ' -f20)" = "$2" ]
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
	start) cmdStart "$@" ;;
	list) cmdList ;;
	url) cmdUrl "$@" ;;
	stop) cmdStop "$@" ;;
	disable) cmdDisable "$@" ;;
	remove) cmdRemove "$@" ;;
	clone) cmdClone "$@" ;;
	restart) cmdRestart "$@" ;;
	restart-all) cmdRestartAll ;;
	on-update) cmdOnUpdate ;;
	tidy) cmdTidy "$@" ;;
	teardown) cmdTeardown ;;
	-h|--help|help) usage ;;
	"") usage >&2; exit 2 ;;
	*) note "rrcd: unknown command $cmd"; usage >&2; exit 2 ;;
esac
