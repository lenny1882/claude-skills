#!/usr/bin/env bash
# rrc: one Claude Remote Control session in a repo, as a detached process.
#
# Why this exists: `claude remote-control --spawn session` opens one session
# reachable from claude.ai, but only in its own directory, and its URL is
# buried in a redrawing status screen. Starting one by hand means trusting the
# repo in ~/.claude.json, running it somewhere that outlives the shell, and
# fishing the URL out of the output. rrc does it the same way every time.
#
# The parts repo-remote-control-server's rrcd needs too (finding the repo,
# trust, the lock, reading the output) are in ../lib/rrc-lib.sh, which both
# source.
#
# Why no systemd: 1.0.0 ran each session as an rrc-session@ user unit, and
# the first real one failed (2 Nov, Ubuntu 20.04, systemd 245): systemd could
# not find the unit's %i.env for a path with a hyphen in it, and ignored
# StandardOutput=truncate:, which needs systemd 248. A session needs nothing a
# unit gives: it is never restarted and never comes back at boot. setsid
# nohup keeps it running after rrc, the Bash call that ran rrc, the Claude
# Code that made that call and an SSH logout have all gone (tested 2 Nov;
# DESIGN.md "Detached sessions").
#
# Things that look simplifiable and are not:
# - The URL is read from the session's output on every call, never stored.
# - A PID file is only believed while that PID is a remote-control running in
#   the repo: PIDs are reused, and a reused one must never be listed, handed
#   out or killed.
# - The lock fds are closed in the session's process. It outlives rrc, and
#   an inherited lock would block every later rrc for a minute.
# - claude keeps each folder's last session in bridge-pointer.json and the
#   next --spawn session there resumes it. Once that session was ended in the
#   app, the resume fails with a 404 and the process stays up holding the
#   folder, printing the dead URL. So a pointer no live process owns is
#   deleted before a start.
# - rrc must run outside Claude's sandbox: the sandbox blocks ~/.claude.json,
#   and a sandboxed call has its own PID namespace, so a session started from
#   one dies with it. The installer adds "rrc *" to sandbox.excludedCommands.
#   That entry only matches a call that is rrc and nothing else: chained,
#   redirected, or run by its full path, it stays sandboxed and fails.

set -euo pipefail

PROG=rrc
CLAUDE_DIR=${CLAUDE_DIR:-$HOME/.claude}
SKILL=${RRC_SKILL_DIR:-$CLAUDE_DIR/skills/repo-remote-control-session}
STATE=${RRC_STATE:-$SKILL/state}
CLAUDE_BIN=${RRC_CLAUDE:-$HOME/.local/bin/claude}
# how long to wait out an "already served" refusal, and how often to retry
REFUSED_WAIT=${RRC_REFUSED_WAIT:-300}
REFUSED_RETRY=${RRC_REFUSED_RETRY:-15}
[ -f "$SKILL/lib/rrc-lib.sh" ] || { printf 'rrc: the repo-remote-control-session skill is not installed: no %s\n' "$SKILL/lib/rrc-lib.sh" >&2; exit 1; }
# shellcheck source=../lib/rrc-lib.sh
. "$SKILL/lib/rrc-lib.sh"

usage() {
	cat <<-'EOF'
		usage: rrc <command> [options] [dir]

		  session [dir]   one session in the repo: ends when the conversation
		                  does, never comes back at boot. Prints the repo root,
		                  then the session's URL
		      --permission-mode <mode>   (default auto)
		      --name <title>             the session's title
		      --allow-unsandboxed        start even though sandbox.enabled is off;
		                                 only with the user's explicit yes
		  list            every running session and its URL
		  teardown        stop every session: run before uninstalling

		dir defaults to the current directory; any directory inside the repo will do.
		Give people the URL rrc prints, never the environment's name.
		Servers, which survive reboots, are repo-remote-control-server's: rrcd.
	EOF
}

# --------------------------------
# sessions and their files

sessionPidFileOf() { printf '%s/sessions/%s.pid' "$STATE" "$1"; }
sessionLogOf() { printf '%s/logs/%s.session.log' "$STATE" "$1"; }
sessionUrlIn() { plain "$1" | grep -o 'https://claude\.ai/code/session_[A-Za-z0-9_-]*' | tail -1 || true; }

isRemoteControl() { tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -q 'remote-control'; }

# the pid is a remote-control running in root
liveSession() { # pid root
	[ -n "$1" ] && [ -d "/proc/$1" ] || return 1
	[ "$(readlink "/proc/$1/cwd" 2>/dev/null)" = "$2" ] || return 1
	isRemoteControl "$1"
}

# the PID in a PID file, only while it is that session
sessionPid() { # pid file
	local pid root
	pid=$(valueIn "$1" RRC_PID); root=$(valueIn "$1" RRC_ROOT)
	liveSession "$pid" "$root" && printf '%s' "$pid"
}

# TERM, then KILL after 10 seconds
stopPid() { # pid
	local i
	kill "$1" 2>/dev/null || return 0
	for i in $(seq 1 50); do [ -d "/proc/$1" ] && isRemoteControl "$1" || return 0; sleep 0.2; done
	kill -9 "$1" 2>/dev/null || true
}

# Claude Code's folder for a path: every character but letters and digits
# becomes "-". Checked against ~/.claude/projects on 2 Nov.
pointerOf() { printf '%s/projects/%s/bridge-pointer.json' "$CLAUDE_DIR" "$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"; }

# a pointer to a session no live process holds would be resumed, and fail
clearPointer() { # root
	local p pid
	p=$(pointerOf "$1")
	[ -f "$p" ] || return 0
	pid=$(jq -r '.pid // empty' "$p" 2>/dev/null || true)
	if [ -n "$pid" ] && [ -d "/proc/$pid" ] && isRemoteControl "$pid"; then return 0; fi
	rm -f "$p"
}

# Started from the root, in a session of its own, with no terminal and the
# lock fds closed. The subshell is not a process group leader, so setsid
# does not fork, and $! is the claude process the PID file names.
startSession() { # root log pidfile args...
	local root=$1 log=$2 pidfile=$3; shift 3
	: >"$log"
	(cd "$root" && exec setsid nohup "$CLAUDE_BIN" remote-control --spawn session "$@" >"$log" 2>&1 </dev/null 8>&- 9>&-) &
	printf 'RRC_PID=%s\nRRC_ROOT="%s"\n' "$!" "$root" >"$pidfile.tmp" && mv "$pidfile.tmp" "$pidfile"
}

# like rrc-lib.sh's waitForUrl, which watches a unit: this watches the PID
waitForSession() { # root log pidfile args...
	local root=$1 log=$2 pidfile=$3 url err pid end retried=0 refusedEnd="" told=no; shift 3
	end=$((SECONDS + WAIT))
	while :; do
		pid=$(valueIn "$pidfile" RRC_PID)
		url=$(sessionUrlIn "$log")
		[ -n "$url" ] && { printf '%s\n' "$url"; return 0; }
		if [ "$retried" = 0 ] && plain "$log" | grep -q 'Workspace not trusted'; then
			note "  Claude says the repo is not trusted; another claude may have rewritten $CLAUDE_JSON. Setting it again and restarting."
			stopPid "$pid"
			setTrust "$root"
			startSession "$root" "$log" "$pidfile" "$@"
			retried=1
			continue
		fi
		# Refused while the folder's last session or server is still
		# registered: up to about 3 minutes after a session stops (131 to
		# 194 s in Docker, 2 Nov), about 70 after a server. Waited out here,
		# so a start after ending a session in the app still succeeds.
		if plain "$log" | grep -q 'already served'; then
			stopPid "$pid"; rm -f "$pidfile"
			[ -n "$refusedEnd" ] || refusedEnd=$((SECONDS + REFUSED_WAIT))
			if [ "$SECONDS" -ge "$refusedEnd" ]; then
				die "$(lastErrorIn "$log") (still refused after ${REFUSED_WAIT}s: a server or session in this folder is still running, or stopped only just now: try again in a few minutes). Output: $log"
			fi
			[ "$told" = yes ] || { note "  the folder's last session is still registered, which clears a few minutes after it stops; waiting up to ${REFUSED_WAIT}s"; told=yes; }
			sleep "$REFUSED_RETRY"
			clearPointer "$root"
			startSession "$root" "$log" "$pidfile" "$@"
			end=$((SECONDS + WAIT))
			continue
		fi
		if ! liveSession "$pid" "$root"; then
			rm -f "$pidfile"
			err=$(lastErrorIn "$log")
			die "the session exited. Last error: ${err:-none}. Output: $log"
		fi
		if [ "$SECONDS" -ge "$end" ]; then
			stopPid "$pid"; rm -f "$pidfile"
			err=$(lastErrorIn "$log")
			die "no URL after ${WAIT}s, so the session was stopped. Last error: ${err:-none}. Output: $log"
		fi
		sleep "$POLL"
	done
}

# --------------------------------
# commands

cmdSession() {
	local dir=. mode=auto name="" allow=no
	while [ $# -gt 0 ]; do
		case $1 in
			--permission-mode) mode=${2:-}; shift ;;
			--permission-mode=*) mode=${1#*=} ;;
			--name) name=${2:-}; shift ;;
			--name=*) name=${1#*=} ;;
			--allow-unsandboxed) allow=yes ;;
			-*) die "session: unknown option $1" ;;
			*) dir=$1 ;;
		esac
		shift
	done
	case " $MODES " in *" $mode "*) ;; *) die "session: --permission-mode must be one of: $MODES" ;; esac

	local root inst pidfile log url pid
	root=$(repoRoot "$dir"); inst=$(instanceOf "$root")
	pidfile=$(sessionPidFileOf "$inst"); log=$(sessionLogOf "$inst")
	lock

	# Claude refuses a session beside a server in the same folder. The server
	# is repo-remote-control-server's, which knows its own URL.
	if systemctl --user is-active --quiet "$(serverUnitOf "$inst")" 2>/dev/null; then
		url=$(command -v rrcd >/dev/null 2>&1 && rrcd url "$root" 2>/dev/null || true)
		die "$root has a server, and Claude refuses a single session beside it. Open a new session from the server's URL instead: ${url:-run rrcd list for it}"
	fi
	if pid=$(sessionPid "$pidfile"); then
		url=$(sessionUrlIn "$log")
		[ -n "$url" ] || url=$(waitForSession "$root" "$log" "$pidfile")
		note "a session is already running in $root; this is its URL"
		printf '%s\n%s\n' "$root" "$url"
		return 0
	fi
	[ "$allow" = yes ] || needSandbox "it applies to this one session."

	local args=(--permission-mode "$mode")
	[ -n "$name" ] && args+=(--name "$name")
	mkdir -p "$STATE/sessions" "$STATE/logs"
	setTrust "$root"
	clearPointer "$root"
	startSession "$root" "$log" "$pidfile" "${args[@]}"
	url=$(waitForSession "$root" "$log" "$pidfile" "${args[@]}")
	printf '%s\n%s\n' "$root" "$url"
	note "one session: it ends when the conversation does, and never comes back at boot"
}

cmdList() {
	local f any=no url
	shopt -s nullglob
	for f in "$STATE"/sessions/*.pid; do
		sessionPid "$f" >/dev/null || { rm -f "$f"; continue; }
		any=yes
		printf '%s\n  one session, running\n' "$(valueIn "$f" RRC_ROOT)"
		url=$(sessionUrlIn "$(sessionLogOf "$(basename "$f" .pid)")")
		[ -n "$url" ] && printf '  %s\n' "$url"
	done
	[ "$any" = yes ] || echo "no session is running; open one with: rrc session <dir>"
	return 0
}

cmdTeardown() {
	local f pid
	shopt -s nullglob
	for f in "$STATE"/sessions/*.pid; do
		pid=$(sessionPid "$f") && stopPid "$pid"
		rm -f "$f"
	done
	# 1.0.0 ran sessions as rrc-session@ units, linked from the skill
	if [ -L "$UNIT_DIR/rrc-session@.service" ] || [ -e "$UNIT_DIR/rrc-session@.service" ]; then
		systemctl --user stop 'rrc-session@*' 2>/dev/null || true
		systemctl --user reset-failed 'rrc-session@*' 2>/dev/null || true
		rm -f "$UNIT_DIR/rrc-session@.service"
		systemctl --user daemon-reload 2>/dev/null || true
	fi
	echo "stopped every session"
}

main() {
	local cmd=${1:-}
	[ $# -gt 0 ] && shift
	case $cmd in
		session) cmdSession "$@" ;;
		list) cmdList ;;
		teardown) cmdTeardown ;;
		-h|--help|help) usage ;;
		"") usage >&2; exit 2 ;;
		*) note "rrc: unknown command $cmd"; usage >&2; exit 2 ;;
	esac
}

main "$@"
