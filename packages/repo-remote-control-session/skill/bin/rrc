#!/usr/bin/env bash
# rrc: one Claude Remote Control session in a repo, as a systemd user unit.
#
# Why this exists: `claude remote-control --spawn session` opens one session
# reachable from claude.ai, but only in its own directory, and its URL is
# buried in a redrawing status screen. Starting one by hand means trusting the
# repo in ~/.claude.json, running it somewhere that outlives the shell, and
# fishing the URL out of the output. rrc does it the same way every time.
#
# The parts repo-remote-control-server's rrcd needs too (finding the repo,
# trust, the lock, reading the output) are in ../lib/rrc-lib.sh, which both
# source.
#
# Things that look simplifiable and are not:
# - The URL is read from the session's output on every call, never stored.
# - rrc must run outside Claude's sandbox: the sandbox blocks the user bus,
#   ~/.config/systemd/user and ~/.claude.json. The installer adds "rrc *" to
#   sandbox.excludedCommands. That entry only matches a call that is rrc and
#   nothing else: chained, redirected, or run by its full path, it stays
#   sandboxed and fails.

set -euo pipefail

PROG=rrc
CLAUDE_DIR=${CLAUDE_DIR:-$HOME/.claude}
SKILL=${RRC_SKILL_DIR:-$CLAUDE_DIR/skills/repo-remote-control-session}
STATE=${RRC_STATE:-$SKILL/state}
[ -f "$SKILL/lib/rrc-lib.sh" ] || { printf 'rrc: the repo-remote-control-session skill is not installed: no %s\n' "$SKILL/lib/rrc-lib.sh" >&2; exit 1; }
# shellcheck source=../lib/rrc-lib.sh
. "$SKILL/lib/rrc-lib.sh"

usage() {
	cat <<-'EOF'
		usage: rrc <command> [options] [dir]

		  session [dir]   one session in the repo: ends when the conversation
		                  does, never comes back at boot. Prints the repo root,
		                  then the session's URL
		      --permission-mode <mode>   (default auto)
		      --name <title>             the session's title
		      --allow-unsandboxed        start even though sandbox.enabled is off;
		                                 only with the user's explicit yes
		  list            every running session and its URL
		  teardown        stop every session and unlink the unit: run before
		                  uninstalling

		dir defaults to the current directory; any directory inside the repo will do.
		Give people the URL rrc prints, never the environment's name.
		Servers, which survive reboots, are repo-remote-control-server's: rrcd.
	EOF
}

# --------------------------------
# session units and files

sessionUnitOf() { printf 'rrc-session@%s.service' "$1"; }
sessionEnvOf() { printf '%s/sessions/%s.env' "$STATE" "$1"; }
sessionLogOf() { printf '%s/logs/%s.session.log' "$STATE" "$1"; }

# The unit template lives with the skill; systemd only reads units from
# ~/.config/systemd/user, so it is linked there. Linked rather than copied so
# an upgrade of the skill is picked up by the next daemon-reload.
ensureUnits() {
	local src=$SKILL/systemd/rrc-session@.service dst=$UNIT_DIR/rrc-session@.service
	[ -f "$src" ] || die "the repo-remote-control-session skill is not installed: no $src"
	if [ "$(readlink "$dst" 2>/dev/null)" != "$src" ]; then
		mkdir -p "$UNIT_DIR"
		ln -sfn "$src" "$dst"
	fi
	systemctl --user daemon-reload
}

# --------------------------------
# reading the output

sessionUrlIn() { plain "$1" | grep -o 'https://claude\.ai/code/session_[A-Za-z0-9_-]*' | tail -1 || true; }

# --------------------------------
# commands

cmdSession() {
	local dir=. mode=auto name="" allow=no
	while [ $# -gt 0 ]; do
		case $1 in
			--permission-mode) mode=${2:-}; shift ;;
			--permission-mode=*) mode=${1#*=} ;;
			--name) name=${2:-}; shift ;;
			--name=*) name=${1#*=} ;;
			--allow-unsandboxed) allow=yes ;;
			-*) die "session: unknown option $1" ;;
			*) dir=$1 ;;
		esac
		shift
	done
	case " $MODES " in *" $mode "*) ;; *) die "session: --permission-mode must be one of: $MODES" ;; esac
	# one argument each: systemd splits RRC_ARGS on whitespace
	name=$(printf '%s' "$name" | tr -s '[:space:]' '-' | sed 's/^-//; s/-$//')

	local root inst unit env log url
	root=$(repoRoot "$dir"); inst=$(instanceOf "$root")
	unit=$(sessionUnitOf "$inst"); env=$(sessionEnvOf "$inst"); log=$(sessionLogOf "$inst")
	lock

	# Claude refuses a session beside a server in the same folder. The server
	# is repo-remote-control-server's, which knows its own URL.
	if systemctl --user is-active --quiet "$(serverUnitOf "$inst")"; then
		url=$(command -v rrcd >/dev/null 2>&1 && rrcd url "$root" 2>/dev/null || true)
		die "$root has a server, and Claude refuses a single session beside it. Open a new session from the server's URL instead: ${url:-run rrcd list for it}"
	fi
	if systemctl --user is-active --quiet "$unit"; then
		url=$(sessionUrlIn "$log")
		[ -n "$url" ] || url=$(waitForUrl "$unit" "$log" "$root" sessionUrlIn)
		note "a session is already running in $root; this is its URL"
		printf '%s\n%s\n' "$root" "$url"
		return 0
	fi
	[ "$allow" = yes ] || needSandbox "it applies to this one session."

	local args="--permission-mode $mode"
	[ -n "$name" ] && args+=" --name $name"
	mkdir -p "$STATE/sessions" "$STATE/logs"
	printf '# written by rrc session\nRRC_ROOT="%s"\nRRC_ARGS="%s"\n' "$root" "$args" >"$env.tmp" && mv "$env.tmp" "$env"
	setTrust "$root"
	ensureUnits
	startFresh "$unit" "$log"
	url=$(waitForUrl "$unit" "$log" "$root" sessionUrlIn)
	printf '%s\n%s\n' "$root" "$url"
	note "one session: it ends when the conversation does, and never comes back at boot"
}

cmdList() {
	local s inst any=no url
	shopt -s nullglob
	for s in "$STATE"/sessions/*.env; do
		inst=$(basename "$s" .env)
		systemctl --user is-active --quiet "$(sessionUnitOf "$inst")" || continue
		any=yes
		printf '%s\n  one session, running\n' "$(valueIn "$s" RRC_ROOT)"
		url=$(sessionUrlIn "$(sessionLogOf "$inst")")
		[ -n "$url" ] && printf '  %s\n' "$url"
	done
	[ "$any" = yes ] || echo "no session is running; open one with: rrc session <dir>"
	return 0
}

# Undo what rrc set up in systemd. The kit's uninstall.sh cannot do this
# itself, so manifest.sh's pre_uninstall runs it first; state/ stays until
# uninstall removes it.
cmdTeardown() {
	local u
	shopt -s nullglob
	for u in "$STATE"/sessions/*.env; do
		systemctl --user stop "$(sessionUnitOf "$(basename "$u" .env)")" 2>/dev/null || true
	done
	# a failed unit stays listed after its file is gone, until this
	systemctl --user reset-failed 'rrc-session@*' 2>/dev/null || true
	rm -f "$UNIT_DIR/rrc-session@.service"
	systemctl --user daemon-reload 2>/dev/null || true
	echo "stopped every session and unlinked the session unit"
}

main() {
	local cmd=${1:-}
	[ $# -gt 0 ] && shift
	case $cmd in
		session) cmdSession "$@" ;;
		list) cmdList ;;
		teardown) cmdTeardown ;;
		-h|--help|help) usage ;;
		"") usage >&2; exit 2 ;;
		*) note "rrc: unknown command $cmd"; usage >&2; exit 2 ;;
	esac
}

main "$@"
