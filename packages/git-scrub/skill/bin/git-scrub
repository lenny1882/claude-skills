#!/usr/bin/env bash
# git-scrub: keeps forbidden values, labels and figures out of a repo's commits.
#
#   git scrub staged          check the staged diff's added lines (pre-commit)
#   git scrub message FILE    check a commit message, skipping # lines (commit-msg)
#   git scrub push [TIP ARGS] check what a push sends: pre-push ref lines on stdin, or
#                             TIP and rev-list ARGS naming the new commits
#   git scrub tree [COMMIT]   check every line of every tracked file at COMMIT (HEAD)
#   git scrub history [--sweep|--map]  check every blob ever committed, every commit
#                             message, author and committer; --sweep also sends each
#                             distinct line to the model once; --map writes a starting
#                             replacement map from the findings
#   git scrub rewrite         replace the mapped values through the whole history, rewrite
#                             identities, drop paths and delete message lines; never pushes
#   git scrub text            check where<TAB>text lines on stdin
#   git scrub enable          install the hooks in this repo, chained to its own
#   git scrub disable         put the repo's hooks back as they were
#   git scrub id              print this repo's id and config folder
#
# Exit codes (P4): 0 clean, 1 findings, 2 a check could not run.
# Each run writes counts and categories, never a matched value, to its config's log and
# to ${TMPDIR:-/tmp}/git-scrub-<subcommand>.log (E9).
set -uo pipefail
export LC_ALL=C.UTF-8          # C1.6: accented names match the same from any shell
umask 077

self=$(readlink -f "${BASH_SOURCE[0]}")
# Run from the skill, lib/ is beside bin/; run from a copy on PATH, it is the skill's.
LIB=$(cd "$(dirname "$self")/../lib" 2>/dev/null && pwd) || LIB=${CLAUDE_DIR:-$HOME/.claude}/skills/git-scrub/lib
[ -f "$LIB/stage1.awk" ] || LIB=${CLAUDE_DIR:-$HOME/.claude}/skills/git-scrub/lib
STATE=${GIT_SCRUB_STATE:-${CLAUDE_DIR:-$HOME/.claude}/skills/git-scrub/state}
GREP=/usr/bin/grep; [ -x "$GREP" ] || GREP=$(command -v grep)
DICTS=(/usr/share/dict/british-english /usr/share/dict/american-english)
HOOKS=(pre-commit commit-msg post-commit pre-push)
CDIR=${CLAUDE_DIR:-$HOME/.claude}
PROJ=$CDIR/projects

sub=${1:-}; [ $# -gt 0 ] && shift
tmplog="${TMPDIR:-/tmp}/git-scrub-${sub:-none}.log"
: > "$tmplog" 2>/dev/null || tmplog=/dev/null

die() { printf 'git-scrub: %s\n' "$1" >&2; printf '%s %s: could not run: %s\n' "$(date -u +%FT%TZ)" "$sub" "$1" >> "$tmplog"; exit 2; }

# C8.3: scrub.id; else the root commit hash, first in sorted order, in a full clone; else,
# in a shallow clone, the root read from a commits-only bare clone of each remote.
# The steps tried go to $work/tried, since repo_id runs in a subshell.
note() { printf '%s; ' "$1" >> "$work/tried"; }
repo_id() {
  local id url t
  id=$(git config --get scrub.id 2>/dev/null) && [ -n "$id" ] && { echo "$id"; return 0; }
  : > "$work/tried"; note "step 1: scrub.id is unset"
  if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" != true ]; then
    id=$(git rev-list --max-parents=0 HEAD 2>/dev/null | sort | head -1)
    [ -n "$id" ] && { echo "$id"; return 0; }
    note "step 2: the repo has no commits"
    return 1
  fi
  note "step 2: a shallow clone holds no root commit"
  for url in $(git remote | while read -r r; do git remote get-url "$r"; done); do
    t=$(mktemp -d)
    if git clone -q --bare --filter=tree:0 "$url" "$t/r" 2>/dev/null; then
      id=$(git -C "$t/r" rev-list --max-parents=0 HEAD 2>/dev/null | sort | head -1)
      rm -rf "$t"
      [ -n "$id" ] && { echo "$id"; return 0; }
      note "step 3: $url has no commits"
    else
      rm -rf "$t"; note "step 3: could not clone $url"
    fi
  done
  [ -n "$(git remote)" ] || note "step 3: no remote to read the root from"
  return 1
}

# C8.4: no config found fails closed. The first match is written to scrub.id.
config_dir() {
  local id
  git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"
  id=$(repo_id) || die "no config found ($(sed "s/; $//" "$work/tried"))"
  [ -d "$STATE/$id" ] || die "no config found: no folder at $STATE/$id"
  [ "$(git config --get scrub.id)" = "$id" ] || git config scrub.id "$id"
  echo "$STATE/$id"
}

# C8.6: the config's hash, which a passed commit is recorded under.
config_hash() {
  find "$cfg" -maxdepth 2 -type f ! -name log ! -name passed -print0 | sort -z | xargs -0 cat 2>/dev/null \
    | cat - "$LIB"/*.awk "$LIB"/*.tsv "$LIB"/*.txt | sha1sum | cut -c1-40
}

setting() { # key default
  local v
  v=$(gawk -F= -v k="$1" '$1 == k { v = substr($0, length(k) + 2) } END { print v }' "$cfg/settings" 2>/dev/null)
  echo "${v:-$2}"
}

# C1.2: every value source, as kind<TAB>value.
values() {
  local file kind expr path
  if [ -f "$cfg/values.txt" ]; then
    gawk '!/^#/ && NF { print "always\t" $0 }' "$cfg/values.txt"
  fi
  [ -f "$cfg/sources.tsv" ] || return 0
  while IFS=$'\t' read -r file kind expr; do
    case $file in ''|'#'*) continue ;; esac
    case $kind in whole|people|always) ;; *) die "sources.tsv: unknown kind '$kind' for $file" ;; esac
    case $file in /*) path=$file ;; *) path=$cfg/$file ;; esac
    [ -f "$path" ] || die "sources.tsv: $file is missing"
    jq -r --arg k "$kind" "($expr) | strings | select(contains(\"\\n\") | not) | \$k + \"\\t\" + ." "$path" \
      || die "sources.tsv: the jq expression for $file failed"
  done < "$cfg/sources.tsv"
}

labels() { # built-in labels, less those turned off, plus the public ones and the repo's own
  local off public
  off=",$(setting labels_off ""),"; public=$(setting public 0)
  gawk -F'\t' -v off="$off" -v public="$public" '!/^#/ && NF >= 3 && index(off, "," $1 ",") == 0 && ($2 == "all" || public == 1) {
    re = $3; for (i = 4; i <= NF; i++) re = re "\t" $i; print $1 "\tsensitive\t" re }' "$LIB/labels.tsv"
  [ -f "$cfg/labels.tsv" ] && gawk '!/^#/ && NF' "$cfg/labels.tsv"
  return 0
}

added_lines() { # PREFIX: a diff on stdin, as where<TAB>text for each added line (C1.1)
  gawk -v pre="$1" '
    /^\+\+\+ / { f = (substr($0, 1, 6) == "+++ b/") ? substr($0, 7) : ""; next }
    /^@@/ { match($0, /\+[0-9]+/); n = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
    /^\+/ && f != "" { print pre f ":" n "\t" substr($0, 2); n++ }'
}

staged_lines() { git -c core.quotePath=false diff --cached -U0 --no-color --text --no-ext-diff | added_lines ""; }

commit_lines() { # COMMIT: its added lines against its first parent
  git -c core.quotePath=false diff-tree -p -U0 --root -m --first-parent --no-commit-id --no-color --text --no-ext-diff "$1" \
    | added_lines "${1:0:12} "
}

tree_lines() { # COMMIT: every line of every tracked text file, read from the commit (C6.2,
  # C6.3: paths whole, from NUL-separated output)
  git -c core.quotePath=false grep -I -n --null --full-name -e '' "$1" -- 2>/dev/null \
    | gawk -v c="${1:0:12}" 'BEGIN { FS = "\0" } { p = $1; sub(/^[^:]*:/, "", p); t = $3; for (i = 4; i <= NF; i++) t = t "\0" $i; print c " " p ":" $2 "\t" t }'
}

# C6.1: every blob reachable from any ref, read once through cat-file --batch, at the
# first path it was seen under; binary blobs (a NUL in the first 8,000 bytes) skipped.
history_lines() {
  git rev-list --all --objects | gawk '{ s = $1; p = substr($0, 42); if (p != "" && !(s in seen)) { seen[s] = 1; print s "\t" p } }' > "$work/objs"
  cut -f1 "$work/objs" | git cat-file --batch-check='%(objectname) %(objecttype)' | gawk '$2 == "blob" { print $1 }' > "$work/blobs"
  git cat-file --batch < "$work/blobs" | LC_ALL=C gawk -v objs="$work/objs" '
    BEGIN { while ((getline l < objs) > 0) { t = index(l, "\t"); path[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    function flush(   i) { if (!bin) for (i = 1; i <= n; i++) print path[sha] "@" substr(sha, 1, 8) ":" i "\t" L[i] }
    want == 0 { sha = $1; size = $3 + 0; got = 0; n = 0; bin = 0; delete L; want = 1; if (size == 0) { getline; want = 0 } ; next }
    {
      if (got < size) { L[++n] = $0; if (got < 8000 && index($0, "\0")) bin = 1 }
      got += length($0) + 1
      if (got >= size + 1) { flush(); want = 0 }
    }'
  git log --all --format='%H%x00%B%x01' | gawk 'BEGIN { RS = "\001" } { sub(/^\n/, ""); t = index($0, "\0"); h = substr($0, 1, 8); n = split(substr($0, t + 1), L, "\n"); for (i = 1; i <= n; i++) if (!(i == n && L[i] == "")) print "commit " h ":" i "\t" L[i] }'
}

# E6: every author and committer, checked against the values (not the labels, since every
# identity holds an email address) and, where the repo names any, the identities (C2.2).
history_identities() {
  git log --all --format='%H%x09%an <%ae>%x09%cn <%ce>' | gawk -F'\t' '{ h = substr($1, 1, 8); print "commit " h " author\t" $2; print "commit " h " committer\t" $3 }' > "$work/ids"
  scan identity "$work/ids"
  local c; for c in $(git rev-list --all); do identity "$c"; done
}

message_lines() { # FILE [PREFIX]
  gawk -v pre="${2:-commit }" '{ if ($0 !~ /^#/) print pre "message:" NR "\t" $0 }' "$1"
}

# E3, C3.1: every typed prompt, as ms<TAB>session<TAB>text, oldest first. Pasted text is
# never read; newlines become \036.
prompts() {
  local f extra
  extra=$(setting prompt_logs "")
  for f in "$CDIR/history.jsonl" ${extra//,/ }; do
    [ -s "$f" ] && [ -r "$f" ] || die "wording is on but the prompt log $f is missing, unreadable or empty"
    jq -R -r '(fromjson? // empty) | select(type == "object" and (.display | type) == "string")
      | [(.timestamp | tostring), (.sessionId // "" | tostring),
         (.display | gsub("\\[Pasted text #[0-9]+[^\\]]*\\]"; " ") | gsub("\t"; " ") | gsub("\n"; "\u001e"))]
      | join("\t")' "$f"
  done | sort -s -n -k1,1
}

# C3.2: what Claude, its tools and subagents produced before MS, from the files given.
produced() { # ms file...
  local ms=$1; shift
  [ $# -gt 0 ] || return 0
  jq -R -r --argjson ms "$ms" '(fromjson? // empty) | select(type == "object")
    | ((.timestamp // "") | if . == "" then null else (sub("\\.[0-9]+Z$"; "Z") | try fromdateiso8601 catch null) end) as $t
    | select($t != null and ($t * 1000) < $ms)
    | if (.isSidechain // false) or .type == "assistant" then (.message.content? // empty | .. | strings)
      elif .type == "user" then (.message.content? | arrays | .[] | select(type == "object" and .type == "tool_result") | .. | strings)
      else empty end
    | gsub("\n"; "\u001e")' "$@" 2>/dev/null
}

# E3: candidate hits from wording.awk over LINES, less those C3.2 rules out, appended to
# found.
wording() { # LINES
  [ -d "$PROJ" ] && [ -r "$PROJ" ] || die "wording is on but the transcript folder $PROJ is missing or unreadable"
  [ -s "$work/prompts" ] || prompts > "$work/prompts" || exit 2
  [ -s "$work/prompts" ] || die "wording is on but no prompt could be read from $CDIR/history.jsonl"
  gawk -v runlen="$(setting run_length 6)" -v floor="$(setting clause_floor 5)" -f "$LIB/wording.awk" \
    "$LIB/stop.txt" "$work/prompts" "$work/head" "$1" > "$work/cands" || die "the wording check failed"
  [ -s "$work/cands" ] || return 0
  : > "$work/ruled"
  local pid ms session files key pat k
  for pid in $(cut -f6 "$work/cands" | sort -un); do
    IFS=$'\t' read -r ms session _ < <(sed -n "${pid}p" "$work/prompts")
    gawk -F'\t' -v p="$pid" '$6 == p { print $4 "\t" $5 }' "$work/cands" | sort -u > "$work/keys"
    # 1: the session the prompt was typed in, with its subagents.
    mapfile -t files < <(find "$PROJ" \( -path "*/$session.jsonl" -o -path "*/$session/subagents/*.jsonl" \) -type f 2>/dev/null)
    produced "$ms" "${files[@]}" | gawk -f "$LIB/lookup.awk" "$work/keys" "$LIB/stop.txt" - > "$work/r1"
    gawk -F'\t' -v p="$pid" '{ print p "\t" $0 }' "$work/r1" >> "$work/ruled"
    # 2: one search per key still standing over every other transcript.
    while IFS=$'\t' read -r k key; do
      /usr/bin/grep -q -x -F "$k	$key" "$work/r1" && continue
      if [ "$k" = para ]; then
        pat=$(tr ' ' '\n' <<< "$key" | gawk '{ print length, $0 }' | sort -rn | head -1 | cut -d' ' -f2)
        mapfile -t others < <("$GREP" -r -l -i -F --include='*.jsonl' -e "$pat" "$PROJ" 2>/dev/null)
      else
        sep='([^a-z0-9'"'"']|\\[nt])+'; pat=${key// /$sep}
        mapfile -t others < <("$GREP" -r -l -i -E --include='*.jsonl' -e "$pat" "$PROJ" 2>/dev/null)
      fi
      [ ${#others[@]} -gt 0 ] || continue
      printf '%s\t%s\n' "$k" "$key" > "$work/key1"
      produced "$ms" "${others[@]}" | gawk -f "$LIB/lookup.awk" "$work/key1" "$LIB/stop.txt" - \
        | gawk -F'\t' -v p="$pid" '{ print p "\t" $0 }' >> "$work/ruled"
    done < "$work/keys"
  done
  gawk -F'\t' 'ARGIND == 1 { ruled[$1 "\t" $2 "\t" $3] = 1; next }
    !(($6 "\t" $4 "\t" $5) in ruled) && !(($1 "\t" $2) in done) { done[$1 "\t" $2] = 1; print $1 "\t" $2 "\t" $3 }' \
    "$work/ruled" "$work/cands" >> "$work/found"
}

# Builds the inputs every scan shares, once per run.
prepare() {
  figures=$(setting figures 0)
  words=$(setting wording "$(setting public 0)")   # E3: opt-in, on by default in a public repo
  values > "$work/values" || exit 2
  cat "${DICTS[@]}" 2>/dev/null > "$work/dict"
  cat "$LIB/common.txt" "$cfg/common.txt" 2>/dev/null > "$work/common"
  cat "$cfg/allow.txt" 2>/dev/null > "$work/allow"
  labels > "$work/labels"
  cat "$cfg/message-lines.ere" 2>/dev/null > "$work/msglines"
  : > "$work/head"; : > "$work/found"; : > "$work/prompts"; nlines=0
  if { [ "$figures" = 1 ] || [ "$words" = 1 ]; } && git rev-parse -q --verify HEAD >/dev/null; then
    git grep -I -h -e . HEAD > "$work/head" 2>/dev/null   # C6.4: once per run
  fi
}

# Stage 1 and wording over LINES, findings appended to found.
scan() { # MODE LINES
  local mode=$1 lines=$2 fig=0
  [ -s "$lines" ] || return 0
  nlines=$((nlines + $(wc -l < "$lines")))
  case $mode in staged|message|text) fig=$figures ;; esac
  gawk -v mode="$mode" -v figures="$fig" -f "$LIB/stage1.awk" \
    "$work/values" "$work/dict" "$work/common" "$work/allow" "$work/labels" "$work/msglines" \
    "$work/head" "$lines" >> "$work/found" || die "stage 1 failed"
  if [ -s "$cfg/patterns.ere" ]; then   # ERE sources, matched case-insensitively (C1.2)
    cut -f2- "$lines" | "$GREP" -n -o -i -E -f <(gawk '!/^#/ && NF' "$cfg/patterns.ere") \
      | gawk -F: 'ARGIND == 1 { v = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); if (v != "" && v !~ /^#/) allow[tolower(v)] = 1; next }
        ARGIND == 2 { t = index($0, "\t"); w[FNR] = substr($0, 1, t - 1); next }
        { n = $1; m = substr($0, length(n) + 2); if (!(tolower(m) in allow)) print w[n] "\tpattern\t" m }' \
        "$work/allow" "$lines" - >> "$work/found"
  fi
  [ "$words" = 1 ] && wording "$lines"
  return 0
}

# E4: the model sweep over LINES that passed stage 1. Batches of 400, the prompt on stdin
# (C4.1), an unusable answer blocking with exit 2 while the other batches still run (C4.2).
sweep_failed=0
sweep() { # LINES
  local lines=$1 cats public n i first last prompt out rc said
  [ -s "$lines" ] || return 0
  if [ "${SWEEP_SKIP:-}" = 1 ]; then echo "$(date -u +%FT%TZ) stage 2 skipped by SWEEP_SKIP=1" | tee -a "$cfg/log" >> "$tmplog"; return 0; fi
  [ "$(setting sweep 1)" = 0 ] && return 0
  public=$(setting public 0)
  cats=$( { [ "$public" = 1 ] && cat "$LIB/public-categories.md"; [ -f "$cfg/categories.md" ] && cat "$cfg/categories.md"; } 2>/dev/null )
  [ -n "$cats" ] || return 0
  gawk -F'\t' 'index($0, "\t") && $2 ~ /[^[:space:]]/' "$lines" > "$work/sw"
  n=$(wc -l < "$work/sw")
  for ((i = 1; i <= n; i += 400)); do
    sed -n "${i},$((i + 399))p" "$work/sw" > "$work/batch"
    said=""
    if [ "$words" = 1 ]; then
      said=$(gawk -f "$LIB/sweep-wording.awk" "$LIB/stop.txt" "$work/batch" "$work/prompts" \
        | gawk '{ print "x\t" $0 }' | gawk -v mode=redact -f "$LIB/stage1.awk" "$work/values" "$work/dict" "$work/common" \
            "$work/allow" "$work/labels" /dev/null /dev/null - | sed 's/^/- /')
    fi
    prompt="You check text that is about to be committed to a git repository.
The repository's owner has had the following categories removed from it and they must
not come back:

$cats

Below, each line is LOCATION<TAB>TEXT. Report every line that contains something in those
categories. Be strict about figures describing the owner's or the company's activity,
internal tool or vendor names, and wording that reads like a quote or close paraphrase of
the owner.$( [ "$public" = 1 ] && printf '%s' " This repository is public: be strict too about any line that is
narrative, history, attribution or commentary rather than a requirement, behaviour, usage
or technical reason." )
${said:+
Things the owner has said (names already replaced). A line that repeats or closely
paraphrases any of these is a quote of the owner, even if reworded:
$said
}
Answer with one line per finding, exactly:
FINDING<TAB>LOCATION<TAB>CATEGORY<TAB>a few words of your own saying what kind of thing it
is (do not quote the line)
and nothing else. If there are none, answer with the single word CLEAN.

--- lines ---
$(cat "$work/batch")
--- end ---"
    out=$(cd "${TMPDIR:-/tmp}" && printf '%s\n' "$prompt" | timeout 600 claude -p --tools "" --no-session-persistence \
      --strict-mcp-config --setting-sources "" --model sonnet --output-format text 2>/dev/null); rc=$?
    first=$(head -1 "$work/batch" | cut -f1); last=$(tail -1 "$work/batch" | cut -f1)
    if [ "$rc" != 0 ] || { ! "$GREP" -q '^FINDING' <<< "$out" && [ "$(tr -d ' .\n' <<< "$out")" != CLEAN ]; }; then
      printf '%s .. %s\tsweep: batch could not be checked\trerun, or check these lines by hand\n' "$first" "$last" >> "$work/found"
      sweep_failed=1; continue
    fi
    gawk -F'\t' '/^FINDING/ { if (NF >= 4) print $2 "\tsweep: " $3 "\t" $4; else print "?\tsweep\t" substr($0, 9) }' <<< "$out" >> "$work/found"
  done
}

# Prints the findings, logs counts and categories only, and exits (E9, P4).
report() { # MODE
  local mode=$1 n counts
  n=$(wc -l < "$work/found"); counts=$(cut -f2 "$work/found" | sort | uniq -c | gawk '{ c = $1; $1 = ""; printf "%s%s x%d", (NR > 1 ? "," : ""), substr($0, 2), c }')
  printf '%s %s: %d line(s), %d finding(s)%s\n' "$(date -u +%FT%TZ)" "$mode" "$nlines" "$n" "${counts:+: $counts}" \
    | tee -a "$cfg/log" >> "$tmplog"
  [ "$n" = 0 ] && exit 0
  printf '\ngit-scrub: %d finding(s) in %s\n' "$n" "$mode" >&2
  head -200 "$work/found" | gawk -F'\t' '{ printf "  %s  [%s]  %s\n", $1, $2, $3 }' >&2
  [ "$n" -gt 200 ] && printf '  ... and %d more\n' $((n - 200)) >&2
  [ "$sweep_failed" = 1 ] && { printf 'git-scrub: the model sweep could not check every batch. SWEEP_SKIP=1 skips it for one run.\n' >&2; exit 2; }
  exit 1
}

# C2.2: each new commit's author and committer is one of the repo's identities, if it
# names any (identity=Name <email> lines in settings).
identity() { # COMMIT
  local c=$1 who
  [ -n "$(gawk -F= '$1 == "identity"' "$cfg/settings" 2>/dev/null)" ] || return 0
  for who in author committer; do
    local fmt=%an; [ $who = committer ] && fmt=%cn
    local id; id=$(git log -1 --format="${fmt} <${fmt/n/e}>" "$c")
    gawk -F= -v id="$id" '$1 == "identity" && substr($0, 10) == id { f = 1 } END { exit !f }' "$cfg/settings" \
      || printf '%s %s\tidentity\t%s\n' "${c:0:12}" "$who" "$id" >> "$work/found"
  done
}

# C2.1, C8.6: the tip's tree always; each new commit's lines, message and identity, unless
# it passed at commit time under the config's current hash.
push_check() { # reads TIP<TAB>RANGE-ARGS lines from $work/refs
  local tip args c h
  h=$(config_hash)
  : > "$work/tree"; : > "$work/added"; : > "$work/msgs"
  while IFS=$'\t' read -r tip args; do
    tree_lines "$tip" >> "$work/tree"
    # shellcheck disable=SC2086
    for c in $(git rev-list --reverse "$tip" $args); do
      identity "$c"
      gawk -F'\t' -v c="$c" -v h="$h" '$1 == c && $2 == h { f = 1 } END { exit !f }' "$cfg/passed" 2>/dev/null && continue
      commit_lines "$c" >> "$work/added"
      git log -1 --format=%B "$c" > "$work/m"; message_lines "$work/m" "${c:0:12} " >> "$work/msgs"
    done
  done < "$work/refs"
  scan tree "$work/tree"; scan staged "$work/added"; scan message "$work/msgs"
  if [ ! -s "$work/found" ]; then   # the sweep reads only the commits that skipped the hooks
    [ -s "$work/prompts" ] || [ "$words" != 1 ] || prompts > "$work/prompts"
    cat "$work/added" "$work/msgs" > "$work/new"; sweep "$work/new"
  fi
  report push
}

# The hooks. A hook git-scrub replaced runs after it, with the same arguments and stdin.
hook_file() { # NAME NEXT: the hook script, chaining to NEXT
  printf '#!/bin/sh\n# git-scrub hook\nnext="%s"\n' "$2"
  case $1 in
    pre-commit) printf '"%s" hook-pre-commit || exit $?\n[ -x "$next" ] && exec "$next" "$@"\n' "$self" ;;
    commit-msg) printf '"%s" hook-commit-msg "$1" || exit $?\n[ -x "$next" ] && exec "$next" "$@"\n' "$self" ;;
    post-commit) printf '"%s" hook-post-commit\n[ -x "$next" ] && exec "$next" "$@"\n' "$self" ;;
    pre-push) printf 'in=$(mktemp) || exit 2\ncat > "$in"\n"%s" push < "$in" || { rc=$?; rm -f "$in"; exit $rc; }\nif [ -x "$next" ]; then "$next" "$@" < "$in"; rc=$?; else rc=0; fi\nrm -f "$in"; exit $rc\n' "$self" ;;
    *) printf '[ -x "$next" ] && exec "$next" "$@"\n' ;;
  esac
  printf 'exit 0\n'
}

ours() { "$GREP" -q '^# git-scrub hook' "$1" 2>/dev/null; }

enable() {
  local gd top name f id hp prev dir
  gd=$(git rev-parse --absolute-git-dir) || die "not in a git repository"
  top=$(git rev-parse --show-toplevel)
  if ! id=$(repo_id); then
    git rev-parse -q --verify HEAD >/dev/null && die "no id found ($(sed "s/; $//" "$work/tried"))"
    id="new-$(cat /proc/sys/kernel/random/uuid)"   # C8.3: moved to the root hash at the first commit
  fi
  git config scrub.id "$id"
  hp=$(git config --get core.hooksPath)
  if [ -n "$hp" ] && [ "$hp" != "$gd/scrub-hooks" ]; then
    # C8.7: the repo's own hooks directory stays as it is; git-scrub's directory calls it.
    case $hp in /*) prev=$hp ;; *) prev=$top/$hp ;; esac
    dir=$gd/scrub-hooks; mkdir -p "$dir"
    git config scrub.prevHooksPath "$hp"
    for f in "$prev"/*; do
      [ -f "$f" ] && [ -x "$f" ] || continue
      name=${f##*/}; case " ${HOOKS[*]} " in *" $name "*) continue ;; esac
      hook_file "$name" "$f" > "$dir/$name"; chmod 755 "$dir/$name"
    done
    for name in "${HOOKS[@]}"; do hook_file "$name" "$prev/$name" > "$dir/$name"; chmod 755 "$dir/$name"; done
    git config core.hooksPath "$dir"
  elif [ -z "$hp" ]; then
    mkdir -p "$gd/hooks"
    for name in "${HOOKS[@]}"; do
      f=$gd/hooks/$name
      if [ -e "$f" ] && ! ours "$f"; then mv "$f" "$f.scrub-chained"; fi
      hook_file "$name" "$f.scrub-chained" > "$f"; chmod 755 "$f"
    done
  fi
  echo "git-scrub: enabled in $top, id $id"
  [ -d "$STATE/$id" ] || echo "git-scrub: no config at $STATE/$id yet; every check refuses until there is one"
}

disable() {
  local gd name f prev
  gd=$(git rev-parse --absolute-git-dir) || die "not in a git repository"
  if prev=$(git config --get scrub.prevHooksPath); then
    git config core.hooksPath "$prev"; git config --unset scrub.prevHooksPath; rm -rf "$gd/scrub-hooks"
  else
    for name in "${HOOKS[@]}"; do
      f=$gd/hooks/$name
      ours "$f" && rm -f "$f"
      [ -e "$f.scrub-chained" ] && mv "$f.scrub-chained" "$f"
    done
  fi
  rm -rf "$gd/scrub"
  echo "git-scrub: disabled; the config is kept"
}

# C7.2: a starting map from history's findings, one placeholder per distinct value,
# numbered by category, for editing before rewrite. Wording, paraphrase and figure findings
# get none (C7.3). Written to map.tsv, or map.new.tsv when map.tsv exists.
write_map() {
  local out=$cfg/map.tsv; [ -e "$out" ] && out=$cfg/map.new.tsv
  gawk -F'\t' '$2 !~ /wording|figure|sweep|identity/ && !(tolower($3) in seen) {
      seen[tolower($3)] = 1; c = ($2 == "real value") ? "name" : $2; gsub(/[^a-z0-9]+/, "-", c); gsub(/^-|-$/, "", c)
      printf "%s\t[%s-%02d]\n", $3, c, ++n[c] }' "$work/found" > "$out"
  echo "git-scrub: wrote $(wc -l < "$out") value(s) to $out; edit the placeholders before git scrub rewrite" >&2
}

# E7, C7.1 to C7.5: rewrite the whole history in place, after a bundle backup.
rewrite() {
  local gd old new bundle ident
  gd=$(git rev-parse --absolute-git-dir)
  [ -z "$(git status --porcelain --untracked-files=no)" ] || die "the working tree has changes; commit or stash them first"
  [ -s "$cfg/map.tsv" ] || [ -s "$cfg/message-lines.ere" ] || [ -s "$cfg/drop-paths.txt" ] || [ -n "$(gawk -F= '$1 == "identity"' "$cfg/settings" 2>/dev/null)" ] \
    || die "nothing to rewrite: no map.tsv, message-lines.ere, drop-paths.txt or identity in $cfg"
  mkdir -p "$gd/scrub"; bundle=$gd/scrub/rewrite-$(date -u +%Y%m%dT%H%M%SZ).bundle
  git bundle create "$bundle" --all 2>/dev/null || die "could not write the backup bundle $bundle"
  chmod 600 "$bundle"
  ident=$(gawk -F= '$1 == "identity" { print substr($0, 10); exit }' "$cfg/settings" 2>/dev/null)
  printf '%s\n' "$ident" > "$work/ident"
  old=$(git rev-list --max-parents=0 HEAD | sort | head -1)
  git -c core.quotePath=false fast-export --all --signed-tags=strip --tag-of-filtered-object=drop --reencode=yes \
    | LC_ALL=C gawk -v map="$cfg/map.tsv" -v msgre="$cfg/message-lines.ere" -v drop="$cfg/drop-paths.txt" -v ident="$work/ident" \
        -f "$LIB/rewrite.awk" \
    | git fast-import --force --quiet || die "the rewrite failed; the old history is in $bundle"
  git reset -q --hard
  new=$(git rev-list --max-parents=0 HEAD | sort | head -1)
  if [ "$new" != "$old" ]; then   # C8.3: the config follows the new root hash
    [ -e "$STATE/$new" ] && die "the rewritten root $new already has a config folder; $cfg was left where it is"
    mv "$STATE/$old" "$STATE/$new"; cfg=$STATE/$new; git config scrub.id "$new"
  fi
  rm -f "$cfg/passed"
  echo "git-scrub: history rewritten; the old history is in $bundle"
  ( "$self" history ); rc=$?
  cat >&2 <<STEPS

What only you can do now:
  1. Check the rewritten history, then force-push every rewritten ref.
  2. Re-clone every other clone; an old clone pushed again brings the old history back.
  3. Ask the host (GitHub Support; Bitbucket support) to purge cached views and old
     commits reachable by SHA.
  4. Delete $bundle once the pushed refs are checked: git gc never removes it.
STEPS
  [ "$rc" = 0 ] || { echo "git-scrub: the history is not clean yet; the findings above need a hand edit or a map entry" >&2; exit 1; }
  exit 0
}

# C8.6: pre-commit and commit-msg leave a mark when they pass; post-commit records the new
# commit as passed only if both marks are for it, so --no-verify leaves it off the list.
mark() { local gd; gd=$(git rev-parse --absolute-git-dir); mkdir -p "$gd/scrub"; echo "$gd/scrub/pending"; }

post_commit() {
  local gd id root p tree msg h
  gd=$(git rev-parse --absolute-git-dir); p=$gd/scrub/pending
  id=$(git config --get scrub.id)
  case $id in new-*)   # the first commit: the config moves to the root hash (C8.3)
    root=$(git rev-list --max-parents=0 HEAD | sort | head -1)
    if [ -d "$STATE/$id" ] && [ ! -e "$STATE/$root" ]; then mv "$STATE/$id" "$STATE/$root"; fi
    git config scrub.id "$root" ;;
  esac
  [ -f "$p" ] || return 0
  IFS=$'\t' read -r tree msg h < "$p"; rm -f "$p"
  cfg=$(config_dir) || return 0
  [ "$tree" = "$(git rev-parse 'HEAD^{tree}')" ] && [ "$msg" = ok ] && [ "$h" = "$(config_hash)" ] \
    && printf '%s\t%s\n' "$(git rev-parse HEAD)" "$h" >> "$cfg/passed"
  return 0
}

work=$(mktemp -d) || die "no temp directory"
trap 'rm -rf "$work"' EXIT
case $sub in
  staged)  cfg=$(config_dir) || exit 2; prepare; staged_lines > "$work/lines"; scan staged "$work/lines"
           [ -s "$work/found" ] || { [ -s "$work/prompts" ] || [ "$words" != 1 ] || prompts > "$work/prompts"; sweep "$work/lines"; }; report staged ;;
  message) [ -f "${1:-}" ] || die "usage: git scrub message FILE"
           cfg=$(config_dir) || exit 2; prepare; message_lines "$1" > "$work/lines"; scan message "$work/lines"
           [ -s "$work/found" ] || { [ -s "$work/prompts" ] || [ "$words" != 1 ] || prompts > "$work/prompts"; sweep "$work/lines"; }; report message ;;
  text)    cfg=$(config_dir) || exit 2; prepare; cat > "$work/lines"; scan text "$work/lines"; report text ;;
  tree)    cfg=$(config_dir) || exit 2; prepare; c=$(git rev-parse --verify "${1:-HEAD}^{commit}") || die "no commit ${1:-HEAD}"
           tree_lines "$c" > "$work/lines"; scan tree "$work/lines"; report tree ;;
  push)    cfg=$(config_dir) || exit 2; prepare
           if [ $# -gt 0 ]; then printf '%s\t%s\n' "$1" "${*:2}" > "$work/refs"
           else
             z=0000000000000000000000000000000000000000
             gawk -v z="$z" '$2 != z { print $2 "\t" ($4 == z ? "--not --remotes" : "--not " $4) }' > "$work/refs"
           fi
           push_check ;;
  history) cfg=$(config_dir) || exit 2; prepare; history_lines > "$work/lines"; scan history "$work/lines"; history_identities
           [ "${1:-}" = --map ] && write_map
           if [ "${1:-}" = --sweep ] && [ ! -s "$work/found" ]; then   # C6.5: each distinct line once
             gawk -F'\t' '!(substr($0, index($0, "\t") + 1) in seen) { seen[substr($0, index($0, "\t") + 1)] = 1; print }' "$work/lines" > "$work/distinct"
             [ -s "$work/prompts" ] || [ "$words" != 1 ] || prompts > "$work/prompts"; sweep "$work/distinct"
           fi
           report history ;;
  rewrite) cfg=$(config_dir) || exit 2; rewrite ;;
  hook-pre-commit)
           p=$(mark); rm -f "$p"; ( "$self" staged ) || exit $?
           cfg=$(config_dir) || exit 2; printf '%s\t-\t%s\n' "$(git write-tree)" "$(config_hash)" > "$p" ;;
  hook-commit-msg)
           ( "$self" message "${1:-}" ) || exit $?
           p=$(mark); [ -f "$p" ] && gawk -F'\t' -v OFS='\t' '{ $2 = "ok"; print }' "$p" > "$p.new" && mv "$p.new" "$p" ;;
  hook-post-commit) post_commit ;;
  enable)  enable ;;
  disable) disable ;;
  id)      cfg=$(config_dir) || exit 2; printf '%s\t%s\n' "$(repo_id)" "$cfg" ;;
  *)       sed -n '2,/^set /{/^#/s/^# \{0,1\}//p}' "$self"; [ -z "$sub" ] || [ "$sub" = help ] || exit 2 ;;
esac
